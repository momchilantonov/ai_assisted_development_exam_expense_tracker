# Copy to .env (repo root, gitignored) and fill in. Never commit real credentials.
# Relative sqlite paths are resolved against backend/.
DATABASE_URL=sqlite:///./data/expense_tracker.db
SESSION_TTL_MINUTES=480
# false only for http://localhost development; must be true behind HTTPS.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=UTC

# Used only by `python -m app.cli create-user` (make seed-user).
# Leave INITIAL_PASSWORD empty to be prompted interactively.
INITIAL_USERNAME=
INITIAL_PASSWORD=
